##################################################
####### GENERATE GROUP FILES #####################
##################################################

rule generate_group_files:
	input:
		AS_METADATA+"/{species}_samples_info.tab"
	output:
		VAST_OUT+"/{species}/Config_groups-{species}.txt"
	shell:
		"""
		echo -e "SampleName\tGroupName" > {output}; \
		cat {input} | awk -v OFS="\t" '{{print $3,$2}}' | sort -k2,2 -k1,1 | uniq >> {output}
		"""

######################################################
####### BILATERIAN CONSERVED INCLUSION TABLES ########
######################################################

##### VERY IMPORTANT: Here I am also filtering for only those exons that are CDS.
rule filter_inclusion_table:
	input:
		inclusion_table = VAST_OUT+"/{species}/INCLUSION_LEVELS_FULL-{species}.tab",
		event_geneID = DATABASE+"/event_gene_correspondences/{species}.Event-Gene.IDs.txt",
		CDS_info =  DATABASE+"/CDS_info/{species}_ONTO_all-v4.tab",
		bilaterian_conserved = "/users/mirimia/fmantica/projects/bilaterian_GE/data/gene_sets/All_version2/STRICT/Bilateria/conserved/Bilateria_conserved_orthogroups-EXPR_genes.txt"
	output:
		VAST_OUT+"/{species}/INCLUSION_LEVELS_FULL-{species}-bilaterian_conserved.tab"
	shell:
		"""
		cat {input.inclusion_table} | awk 'NR==1' > {output}; \
		cat {input.inclusion_table} | translate -a -k <(cat {input.event_geneID} | grep -v "BtaEX6026476" | sort | uniq | awk '$1!="" && $2!=""') 2 \
                | filter_1col 3 <(cat {input.bilaterian_conserved} | cut -f3) | cut -f1,2,4- \
		| filter_1col 2 <(cat {input.CDS_info} | cut -f2,8 | grep CDS | cut -f1) >> {output}
		"""

##################################################
############## COMPUTE TAU  ######################
##################################################

#### NB: N and VLOW samples are not considered when computing the PSI
#PSI is based on the averaged across tissues
rule compute_tau_from_PSI_bilaterian_conserved:
	input:
		inclusion_table = VAST_OUT+"/{species}/INCLUSION_LEVELS_FULL-{species}-bilaterian_conserved.tab",
		metadata = AS_METADATA+"/{species}_samples_info.tab"
	output:
		TAU_CALL+"/{species}-tau-all_EX_events.tab"
	conda:
		CONDA_ENVS+"/R4.2_AS_analysis.yml"
	shell:
		"""
		Rscript {COMPUTE_TAU_FROM_PSI}	{input.inclusion_table} \
						{input.metadata} \
						{output}
		"""


##################################################
####### GET TISSUE SPECIFIC EXONS ################
##################################################

### This is only for bilaterian conserved genes
rule run_get_tis_AS:
	input:
		inclusion_table = VAST_OUT+"/{species}/INCLUSION_LEVELS_FULL-{species}-bilaterian_conserved.tab",
		group_file = VAST_OUT+"/{species}/Config_groups-{species}.txt"
	output:
		stats = TS_CALL+"/{species}/{vlow_category}_dPSI{min_dPSI}-dPSI_glob{min_dPSI_glob}-N{num_group}-Rep{num_rep}-{event_type}/TS_AS-general_stats.txt",
		ts_exons = TS_CALL+"/{species}/{vlow_category}_dPSI{min_dPSI}-dPSI_glob{min_dPSI_glob}-N{num_group}-Rep{num_rep}-{event_type}/TS_AS.tab",
		tissue_dPSI = expand("{path}/{{species}}/{{vlow_category}}_dPSI{{min_dPSI}}-dPSI_glob{{min_dPSI_glob}}-N{{num_group}}-Rep{{num_rep}}-{{event_type}}/dPSIs_{tissue}.tab", path=TS_CALL, tissue=ALL_TISSUES)
	params:
		output_dir = TS_CALL+"/{species}/{vlow_category}_dPSI{min_dPSI}-dPSI_glob{min_dPSI_glob}-N{num_group}-Rep{num_rep}-{event_type}",
		vlow_category = lambda wildcards: VLOW_OPTION_DICT[wildcards.vlow_category],
		all_tissues = ",".join(ALL_TISSUES)
	shell:
		"""
		cd {params.output_dir};
		perl {GET_TIS_AS} {input.inclusion_table} \
			-g {input.group_file} \
			--min_dPSI {wildcards.min_dPSI} \
			--min_dPSI_glob {wildcards.min_dPSI_glob} \
			-test_tis {params.all_tissues} \
			--min_rep {wildcards.num_rep} \
			-N {wildcards.num_group} \
			--print \
			--event_type {wildcards.event_type} \
			{params.vlow_category} \
			> {output.stats}
		"""


###################################################################################
##### ADD COVERAGE, TAU, SPECIALIZATION PATTERNS AND GENE OG INFO #################
###################################################################################

### We should require that the tissue with tissue-specificity has at least one sample that is different from N and VLOW
### The idea is also that true TS will have PSI in other tissues very close to zero (true specialization pattern).
### Importantly: all the filtering will be done a posteriori
### The orthogroups used here is ALL and not EXPR. Why is that?
rule asssociate_ts_exons_with_extra_info:
	input:
		ts_exons = TS_CALL+"/{species}/{vlow_category}_dPSI{min_dPSI}-dPSI_glob{min_dPSI_glob}-N{num_group}-Rep{num_rep}-{event_type}/TS_AS.tab",
		inclusion_table = VAST_OUT+"/{species}/INCLUSION_LEVELS_FULL-{species}-bilaterian_conserved.tab",
		group_file = VAST_OUT+"/{species}/Config_groups-{species}.txt",
		tau_file = TAU_CALL+"/{species}-tau-all_EX_events.tab",
		exons_gene_dict = DATABASE+"/event_gene_correspondences/{species}.Event-Gene.IDs.txt",
		gene_orthogroups = GENE_ORTHOLOGIES_DIR+"/Bilateria_conserved_orthogroups-ALL_genes.txt"
	output:
		TS_CALL+"/{species}/{vlow_category}_dPSI{min_dPSI}-dPSI_glob{min_dPSI_glob}-N{num_group}-Rep{num_rep}-{event_type}/TS_AS-associated_tissue_dPSI{min_dPSI_ts}-spec_pattern_PSI{min_PSI_spec}-all_extra_info.tab"
	conda:
		CONDA_ENVS+"/R4.2_AS_analysis.yml"
	shell:
		"""
		Rscript {ASSOCIATE_TS_EXONS_WITH_EXTRA_INFO}	--ts_exons {input.ts_exons} \
								--inclusion_table {input.inclusion_table} \
								--sample_tissue {input.group_file} \
								--taus {input.tau_file} \
								--exons_gene_dict {input.exons_gene_dict} \
								--gene_orthogroups {input.gene_orthogroups} \
								--min_dPSI_ts {wildcards.min_dPSI_ts} \
								--specialization_PSI_cutoff {wildcards.min_PSI_spec} \
								--output {output} 
		"""

##################################################
####### DEFINE STRONG AND MILD TS-AS #############
##################################################

rule define_ts_and_patas_events:
	input:
		TS_CALL+"/{species}/{vlow_category}_dPSI{min_dPSI}-dPSI_glob{min_dPSI_glob}-N{num_group}-Rep{num_rep}-{event_type}/TS_AS-associated_tissue_dPSI{min_dPSI_ts}-spec_pattern_PSI{min_PSI_spec}-all_extra_info.tab"
	output:
		all_as = TS_CALL+"/{species}/{vlow_category}_dPSI{min_dPSI}-dPSI_glob{min_dPSI_glob}-N{num_group}-Rep{num_rep}-{event_type}/TS_types/All_AS_types-associated_tissue_dPSI{min_dPSI_ts}-spec_pattern_PSI{min_PSI_spec}-tau_{min_ts_tau}.tab",
		ts_as = TS_CALL+"/{species}/{vlow_category}_dPSI{min_dPSI}-dPSI_glob{min_dPSI_glob}-N{num_group}-Rep{num_rep}-{event_type}/TS_types/TS_AS_selected-associated_tissue_dPSI{min_dPSI_ts}-spec_pattern_PSI{min_PSI_spec}-tau_{min_ts_tau}.tab",
		patas = TS_CALL+"/{species}/{vlow_category}_dPSI{min_dPSI}-dPSI_glob{min_dPSI_glob}-N{num_group}-Rep{num_rep}-{event_type}/TS_types/PaTAS-associated_tissue_dPSI{min_dPSI_ts}-spec_pattern_PSI{min_PSI_spec}-tau_{min_ts_tau}.tab",
		discarded = TS_CALL+"/{species}/{vlow_category}_dPSI{min_dPSI}-dPSI_glob{min_dPSI_glob}-N{num_group}-Rep{num_rep}-{event_type}/TS_types/discarded_events-associated_tissue_dPSI{min_dPSI_ts}-spec_pattern_PSI{min_PSI_spec}-tau_{min_ts_tau}.tab"
	conda:
		CONDA_ENVS+"/R4.2_AS_analysis.yml"
	shell:
		"""
		Rscript {DEFINE_TS_AND_PATAS_EXONS}	--input {input} \
							--output_all {output.all_as} \
							--output_ts {output.ts_as} \
							--output_patas {output.patas} \
							--output_discarded {output.discarded} \
							--tau_cutoff {wildcards.min_ts_tau}
		"""
