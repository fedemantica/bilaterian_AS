GET_TIS_AS = config["tools"]["get_tis_AS"]
COMPUTE_TAU_FROM_PSI = config["tools"]["compute_tau_from_PSI"]
RUN_GPROFILER2 = config["tools"]["run_gprofiler2"]
ASSOCIATE_TS_EXONS_WITH_EXTRA_INFO = config["tools"]["associate_ts_exons_to_extra_info"]
DEFINE_TS_AND_PATAS_EXONS = config["tools"]["define_ts_and_patas_exons"]
COMPUTE_RANKED_PSI = config["tools"]["compute_ranked_PSI_across_tissues"]

###### variables ###########
MY_VERSION = config["variables"]["my_version"]
ALL_SPECIES = config["variables"]["all_species"]
ALL_TISSUES = config["variables"]["all_tissues"]
VLOW_OPTION_DICT = config["variables"]["vlow_option_dict"]

###### targets ##########
CONFIG_FILES = expand("{path}/{species}/Config_groups-{species}.txt", path=VAST_OUT, species=ALL_SPECIES)
BIL_CONS_INCLUSION_TABLES = expand("{path}/{species}/INCLUSION_LEVELS_FULL-{species}-bilaterian_conserved.tab", path=VAST_OUT, species=ALL_SPECIES)
BIL_CONS_TS_EXONS_CALL = expand("{path}/bilaterian_conserved/{species}/TS-{species}-N{num_group}-Rep{num_rep}-{event_type}-general_stats.txt", path=TS_CALL, species=ALL_SPECIES, num_group=4, num_rep=1, event_type="EX")

ALL_EXONS_TAU = expand("{path}/bilaterian_conserved/{species}-tau-all_EX_events.tab", path=TAU_CALL, species=ALL_SPECIES)
ALL_TS_EXONS_EXTRA_INFO = expand("{path}/{species}/{vlow_category}_dPSI{min_dPSI}-dPSI_glob{min_dPSI_glob}-N{num_group}-Rep{num_rep}-{event_type}/TS_AS-associated_tissue_dPSI{min_dPSI_ts}-spec_pattern_PSI{min_PSI_spec}-all_extra_info.tab", path=TS_CALL, species=ALL_SPECIES, vlow_category="All", min_dPSI=10, min_dPSI_glob=25, num_group=4, num_rep=1, event_type="EX", min_dPSI_ts=15, min_PSI_spec=15)

RANKED_PSI = expand("{path}/{species}-ranked_PSIs-all_EX_events.tab", path=TAU_CALL, species=ALL_SPECIES)

TS_AND_PATAS_SETS = expand("{path}/{species}/{vlow_category}_dPSI{min_dPSI}-dPSI_glob{min_dPSI_glob}-N{num_group}-Rep{num_rep}-{event_type}/TS_types/All_AS_types-associated_tissue_dPSI{min_dPSI_ts}-spec_pattern_PSI{min_PSI_spec}-tau_{min_ts_tau}.tab", path=TS_CALL, species=ALL_SPECIES, vlow_category="All", min_dPSI=10, min_dPSI_glob=25, num_group=4, num_rep=1, event_type="EX", min_dPSI_ts=15, min_PSI_spec=15, min_ts_tau=0.60)

