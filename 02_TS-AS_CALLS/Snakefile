DATA = config["general_paths"]["data"]
SRC = config["general_paths"]["src"]
CONDA_ENVS = config["general_paths"]["conda_envs"]
AS_METADATA = config["paths"]["as_metadata"]
VAST_OUT = config["paths"]["vast_out"]
TS_CALL = config["paths"]["ts_call"]
TAU_CALL = config["paths"]["tau_call"]
DATABASE = config["paths"]["database"]
GENE_ORTHOLOGIES_DIR = config["paths"]["gene_orthologies_dir"]
### I still need to see if to keep these GO enrichments or not
GO_TRANSFERS = config["paths"]["GO_transfers"]

