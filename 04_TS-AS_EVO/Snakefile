#The filename of the second input changed for the new runs: from _corrected_extraexons.tab to _extraexons_corrected.tab
rule add_info_to_exon_orthogroups:
	input:
		ex_orthogroups = EXORTHIST_DIR+"/EX_{exon_OG_category}.tab",
		vastID_coord_dict = expand("{path}/{species}_extraexons_corrected.tab", path=ALL_EXTRAEXONS, species=ALL_SPECIES),
		overlapping_groups = EXORTHIST_DIR+"/overlapping_EXs_by_species.tab"
	output:
		DATA+"/{processed_orthologies_dir}/EX_{exon_OG_category}-added_info.tab"
		#EXORTHIST_DIR+"/EX_{exon_OG_category}-added_info.tab"
	shell:
		"""
		python {ADD_INFO_TO_EXON_ORTHOGROUPS}	--ex_orthogroups {input.ex_orthogroups} \
							--vastID_coords {input.vastID_coord_dict} \
							--overlapping_groups {input.overlapping_groups} \
							--output {output}
		"""


######################################################################
######## FILTER FOR BILATERIAN CONSERVED ORTHOGROUPS #################
######################################################################

rule filter_for_bilaterian_conserved_OGs:
	input:
		ex_orthogroups = DATA+"/{processed_orthologies_dir}/EX_{exon_OG_category}-added_info.tab",
		#ex_orthogroups = EXORTHIST_DIR+"/EX_{exon_OG_category}-added_info.tab",
		bilaterian_conserved_OGs = "/users/mirimia/fmantica/projects/bilaterian_GE/data/gene_sets/All_version2/STRICT/Bilateria/conserved/Bilateria_conserved_orthogroups-EXPR_genes.txt"
	output:
		DATA+"/{processed_orthologies_dir}/EX_{exon_OG_category}-added_info-bilaterian_conserved.tab"
		#EXORTHIST_DIR+"/EX_{exon_OG_category}-added_info-bilaterian_conserved.tab"
	run:
		import pandas as pd
		import re

		### Upload exon orthogroups
		exon_OG_df = pd.read_table(str(input.ex_orthogroups), sep="\t", header=0, index_col=False)
		exon_OG_df["OG_ID"] = [re.sub("\..*", "", element) for element in list(exon_OG_df["ExCluster_ID"])] #Add gene orthogroup ID
		### Upload bilaterian conserved gene orthogroups
		gene_OG_df = pd.read_table(str(input.bilaterian_conserved_OGs), sep="\t", header=None, index_col=False, names=["OG_ID", "Species", "GeneID"])
		bilaterian_conserved_OG_IDs_list = list(set(list(gene_OG_df["OG_ID"])))
		### Filter exon orthogroups and save to file
		bilaterian_conserved_exon_OG_df = exon_OG_df.loc[exon_OG_df["OG_ID"].isin(bilaterian_conserved_OG_IDs_list)]		
		bilaterian_conserved_exon_OG_df.to_csv(str(output), sep="\t", header=True, index=False, na_rep="NA")


