rule generate_extree_input:
	input:
		ex_orthogroups = DATA+"/{processed_orthologies_dir}/EX_{exon_OG_category}-added_info-bilaterian_conserved.tab",
		#ex_orthogroups = EXORTHIST_DIR+"/EX_{exon_OG_category}-added_info-bilaterian_conserved.tab",
		gene_orthogroups = "/users/mirimia/fmantica/projects/mixed_files/manu_orthogroups_gene_names/Bilateria_conserved_orthogroups-gene_names.tab"
	output:
		DATA+"/{processed_orthologies_dir}/EX_{exon_OG_category}-added_info-bilaterian_conserved-ExTree_input.tab"
		#DATA+"/{processed_orthologies_dir}/exorthist_output/EX_{exon_OG_category}-added_info-bilaterian_conserved-ExTree_input.tab"
		#EXORTHIST_DIR+"/EX_{exon_OG_category}-added_info-bilaterian_conserved-ExTree_input.tab"
	params:
		ordered_tissues = ",".join(ALL_TISSUES),
		ordered_species = ",".join(ALL_SPECIES),
		ts_call_dir = TS_CALL_DIR+"/bilaterian_conserved",
		#ts_call_dir = DATA+"/ts_call",
		dPSI_prefix = TS_CALL_PARAMS+"/dPSIs_",
		all_reference_annot_dir = ALL_REFERENCE_ANNOT_DIR
	shell:
		"""
		{RSCRIPT} {GENERATE_EXTREE_INPUT} 	{input.ex_orthogroups} \
							{input.gene_orthogroups} \
							{output} \
							{params.ordered_tissues} \
							{params.ordered_species} \
							{params.ts_call_dir} \
							{params.dPSI_prefix} \
							{params.all_reference_annot_dir}
		"""



### Filter ExTree input to only exon orthogroups that contain at least one TS-AS exon in any species
### Header: ExOG_ID	GeneID	Coordinate	Species	Membership_score	VastID	Overlap_groupID	OG_ID	info	exon_length	Neural_PSI	Testis_PSI	Ovary_PSI	Muscle_PSI	Kidney_PSI	Epithelial_PSI	DigestiveTract_PSI	Adipose_PSI	GeneName
### IMPORTANT: this rule depends on the filename
rule filter_extree_input:
	input:
		extree_input = DATA+"/{processed_orthologies_dir}/EX_{exon_OG_category}-added_info-bilaterian_conserved-ExTree_input.tab",
		#extree_input = DATA+"/{processed_orthologies_dir}/exorthist_output/EX_{exon_OG_category}-added_info-bilaterian_conserved-ExTree_input.tab",
		TS_AS = expand("{path}/{species}/reference/{species}-AS_regulated_genes-with_event.tab", path=AS_VS_GE_REG_DIR, species=ALL_SPECIES)
	output:
		extree_output = DATA+"/{processed_orthologies_dir}/EX_{exon_OG_category}-added_info-bilaterian_conserved-ExTree_input-TS-AS_filtered.tab"
		#extree_output = DATA+"/{processed_orthologies_dir}/exorthist_output/EX_{exon_OG_category}-added_info-bilaterian_conserved-ExTree_input-TS-AS_filtered.tab"
	run:
		import pandas as pd
		import os

		### Read inputs
		extree_input_df = pd.read_table(str(input.extree_input), sep="\t", index_col=False, header=0)
		all_TS_AS_genes_df = pd.DataFrame()
		for file in (list(input.TS_AS)):
		  ### Isolate species id
		  filename = os.path.basename(file)
		  species = filename.split("-AS_regulated_genes-with_event.tab")[0]
		  ### Upload species df
		  species_df = pd.read_table(str(file), index_col=False, header=None, names=["GeneID", "VastID", "Tissue", "Direction"])
		  species_df["Species"] = species
		  all_TS_AS_genes_df = pd.concat([all_TS_AS_genes_df, species_df])
		### Isolate gene orthogroups of interest
		selected_ExOG_ID = (extree_input_df[["ExOG_ID", "Species", "GeneID", "VastID"]].merge(all_TS_AS_genes_df, on=["GeneID", "Species", "VastID"], how="inner")["ExOG_ID"])
		extree_output_df = extree_input_df.loc[extree_input_df["ExOG_ID"].isin(selected_ExOG_ID)].copy()
		### Save to file
		extree_output_df.to_csv(str(output.extree_output), sep="\t", header=True, index=False, na_rep="NA")


