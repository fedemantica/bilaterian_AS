#Create inputs for all tissue and species
#This should work even if the Associated tissue contains ";" and if there are "NO_TISSUE"
rule generate_compare_exons_input:
	input:
		DATA+"/{processed_orthologies_dir}/reference/ts_info_file/{species}-bilaterian_conserved-ts_info.tab"
	output:
		DATA+"/{processed_orthologies_dir}/reference/compare_exon_sets_inputs/{tissue}/{species}-{tissue}_exon_list.txt"
	shell:
		"""
		cat {input} | grep "{wildcards.tissue}" | awk -v OFS="\t" '$NF=="UP" {{print $1,$2,$NF}}' > {output} || touch {output}
		"""

### Run compare exons for all species pairs and the selected exons
#This is a bit weird, because I have to use the output from the previous run. Unfortunately, the species identifiers do not match.
#It just requires some adjusting.
rule compare_exons_runs:
	input:
		species1_exons = DATA+"/{processed_orthologies_dir}/{rand_num}/compare_exon_sets_inputs/{tissue}/{species1}-{tissue}_exon_list.txt",
		species2_exons = DATA+"/{processed_orthologies_dir}/{rand_num}/compare_exon_sets_inputs/{tissue}/{species2}-{tissue}_exon_list.txt",
		main_output = EXORTHIST_DIR+"/EX_reclustered.tab"
	output:
		DATA+"/{processed_orthologies_dir}/{rand_num}/compare_exon_sets_inputs/{tissue}/Conserved_exons-{species1}-{species2}.tab",
		DATA+"/{processed_orthologies_dir}/{rand_num}/compare_exon_sets_inputs/{tissue}/Compare_exons_summary_input-{species1}-{species2}.txt"
	params:
		main_output_dir = EXORTHIST_DIR,
		output_dir = DATA+"/{processed_orthologies_dir}/{rand_num}/compare_exon_sets_inputs/{tissue}"
	shell:
		"""
		cd {params.output_dir}; \
		perl {RUN_COMPARE_EXONS} -sp1 {wildcards.species1} \
					-sp2 {wildcards.species2} \
					-exon_list_sp1 {input.species1_exons} \
					-main_folder {params.main_output_dir} \
					-exon_list_sp2 {input.species2_exons} \
					-dPSI_info qual_call \
					-print_out
		"""
