rule generate_ts_info_files_reference:
	input:
		ts_exons_out = TS_CALL_DIR+"/bilaterian_conserved/{species}/"+TS_CALL_PARAMS+"/TS_types/All_AS_types-associated_tissue_dPSI15-spec_pattern_PSI15-tau_0.6.tab",
		filtered_ts_exons = AS_VS_GE_REG_DIR+"/{species}/reference/{species}-AS_regulated_genes-with_event.tab"
	output:
		DATA+"/{processed_orthologies_dir}/reference/ts_info_file/{species}-bilaterian_conserved-ts_info.tab"
	run:
		import pandas as pd

		### Read in files
		ts_exons_df = pd.read_table(str(input.ts_exons_out), sep="\t", index_col=False, header=0)
		filtered_ts_exons_df = pd.read_table(str(input.filtered_ts_exons), sep="\t", index_col=False, header=None, names=["GeneID", "EventID", "Tissue", "Direction"])
		selected_exons = list(filtered_ts_exons_df["EventID"])
		### Filter for selected exons only
		ts_exons_df = ts_exons_df[["GeneID", "COORD", "EventID", "Associated_Tis", "Direction"]]
		ts_exons_df = ts_exons_df.loc[ts_exons_df["EventID"].isin(selected_exons)].copy()
		ts_exons_df.to_csv(str(output), header=False, index=False, sep="\t", na_rep="NA")

