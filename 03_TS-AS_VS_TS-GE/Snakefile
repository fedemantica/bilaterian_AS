rule randomize_TS_exons:
	input:
		AS_reg_genes = AS_VS_GE_REG_DIR+"/{species}/reference/{species}-AS_regulated_genes-with_event.tab",
		coverage_exons = lambda wildcards: expand(TS_CALL+"/bilaterian_conserved/{species}/"+TS_CALL_PARAMS+"/dPSIs_{tissue}.tab", species=wildcards.species, tissue=SPECIES_TISSUES_DICT[wildcards.species]),
		event_gene_ID = DATABASE+"/event_gene_correspondences/{species}.Event-Gene.IDs.txt"
	output:
		AS_reg_with_event = AS_VS_GE_REG_DIR+"/{species}/randomization_{rand_round}/{species}-AS_regulated_genes-with_event.tab",
		AS_reg_without_event = AS_VS_GE_REG_DIR+"/{species}/randomization_{rand_round}/{species}-AS_regulated_genes.tab"
	run:
		import pandas as pd
		import os
		import random

		### Set seed for this to be reproducible
		random.seed(int(wildcards.rand_round))

		### Read inputs
		reg_genes_df = pd.read_table(str(input.AS_reg_genes), sep="\t", header=None, index_col=False, names=["GeneID", "EventID", "Tissue", "Direction"])
		event_geneID_df = pd.read_table(str(input.event_gene_ID), sep="\t", header=0, index_col=False)

		### Cycle on the coverage exons. Just get the EventID and add the relative tissue
		all_tissues_sampled_exons_df = pd.DataFrame()
		for coverage_exon_file in input.coverage_exons:
		  tissue = os.path.basename(coverage_exon_file).replace("dPSIs_", "").replace(".tab", "")
		  number_of_TS_events = (reg_genes_df["Tissue"] == tissue).sum()
		  coverage_exon_df = pd.read_table(str(coverage_exon_file), sep="\t", header=0, index_col=False)[["EventID"]]
		  coverage_exon_df["Tissue"] = tissue
		  ### Get a random number of exons with coverage equal to the real number. Set the random state for reproducibility
		  sampled_exons_df = coverage_exon_df.sample(n=number_of_TS_events, random_state=int(wildcards.rand_round)).reset_index(drop=True)
		  ### Join to combined dataframe
		  all_tissues_sampled_exons_df = pd.concat([all_tissues_sampled_exons_df, sampled_exons_df])

		### Format final dataframes
		event_geneID_dict = pd.Series(event_geneID_df.GeneID.values, index=event_geneID_df.EventID).to_dict()
		all_tissues_sampled_exons_df["GeneID"] = all_tissues_sampled_exons_df["EventID"].map(event_geneID_dict)
		all_tissues_sampled_exons_df["Direction"] = "UP"
		all_tissues_sampled_exons_df = all_tissues_sampled_exons_df[["GeneID", "EventID", "Tissue", "Direction"]]
		all_tissues_sampled_genes_df = all_tissues_sampled_exons_df[["GeneID", "Tissue"]].copy().drop_duplicates()
		### Save to files
		all_tissues_sampled_exons_df.to_csv(str(output.AS_reg_with_event), sep="\t", header=False, index=False, na_rep="NA")
		all_tissues_sampled_genes_df.to_csv(str(output.AS_reg_without_event), sep="\t", header=False, index=False, na_rep="NA")


rule randomize_TS_genes:
	input:
		GE_reg_genes = AS_VS_GE_REG_DIR+"/{species}/reference/{species}-GE_regulated_genes.tab",
		bilaterian_conserved = "/users/mirimia/fmantica/projects/bilaterian_GE/data/ts_gains_losses/species_QN_5_TPM_v6/All_version2/Bilateria_conserved_orthogroups-All_genes-associated_tissues.tab"
	output:
		AS_VS_GE_REG_DIR+"/{species}/randomization_{rand_round}/{species}-GE_regulated_genes.tab"
	params:
		expr_cutoff = "YES_EXPR" #This corresponds to an expr ≥ 5 TPMs in at least one tissue	
	run:
		import pandas as pd
		import random
		import numpy as np

		### Set seed for this to be reproducible
		random.seed(int(wildcards.rand_round))
		
		### Read inputs
		reg_genes_df = pd.read_table(str(input.GE_reg_genes), sep="\t", header=None, index_col=False, names=["GeneID", "Tissue"])
		bilaterian_conserved_df = pd.read_table(str(input.bilaterian_conserved), sep="\t", header=None, index_col=False, names=["OG_ID", "Species", "GeneID", "Tau", "Top_Tis", "Associated_Tis", "Expr_cutoff"])
		bilaterian_conserved_df["Species"] = bilaterian_conserved_df["Species"].replace({"BmA": "Bmo"})
		### Filter only for genes of the queried species
		species_conserved_genes_df = bilaterian_conserved_df.loc[(bilaterian_conserved_df["Species"] == wildcards.species) & (bilaterian_conserved_df["Expr_cutoff"]==params.expr_cutoff)].copy()[["GeneID"]] 
		### Select a random number of TS genes
		label_counts = reg_genes_df["Tissue"].value_counts()
		sampled_genes_df = species_conserved_genes_df.sample(n=label_counts.sum(), random_state=int(wildcards.rand_round)).reset_index(drop=True)
		### Assign labels based on the original counts
		sampled_genes_df["Tissue"] = np.random.RandomState(int(wildcards.rand_round)).permutation(list(reg_genes_df["Tissue"]))
		### Save to file
		sampled_genes_df.to_csv(str(output), sep="\t", index=False, header=False, na_rep="NA")


##################################################
####### GET GENE LENGHT AND EXON NUMBER ##########
##################################################

#Gene length from the gene entry
#Exon number by counting the number of exons

#I am considering only the reference isoform, which is by default the longest isoform anyways.
#Filter for bilaterian conserved genes (this is different from what I was doing in the thesis)
rule get_gene_lenght_and_exon_num:
	input:
		GTF = ALL_GTFS_DIR+"/{species}_annot-B-brochi.gtf",
		bilaterian_conserved = GENE_SETS_DIR+"/STRICT/Bilateria/conserved/Bilateria_conserved_orthogroups-EXPR_genes.txt"
	output:
		AS_VS_GE_REG_DIR+"/{species}/{species}-all_genes-gene_length_and_exon_num.tab"
	run:
		import pandas as pd
		import re

		### Read inputs
		input_gtf = pd.read_table(str(input.GTF), sep="\t", index_col=False, header=None, names=["chr", "source", "feature", "start", "stop", "score", "strand", "frame", "attribute"])
		orthogroups_df = pd.read_table(str(input.bilaterian_conserved), sep="\t", index_col=False, header=None, names=["OG_ID", "Species", "GeneID"])
		### Add gene ID
		my_raw_gene_id = [part for element in list(input_gtf["attribute"]) for part in element.split(";") if "gene_id" in part]
		input_gtf["GeneID"] = [re.sub(".*[ ]", "", re.sub('"', "", element)) for element in my_raw_gene_id]
		### Filter gtf only for protein coding genes
		protein_coding_genes = list(set(list(input_gtf.loc[input_gtf["feature"]=="CDS"]["GeneID"])))
		input_gtf = input_gtf.loc[input_gtf["GeneID"].isin(protein_coding_genes)]
		### Initialize final dataframe
		final_df = pd.DataFrame()
		### Group by gene ID
		grouped_gtf = input_gtf.groupby("GeneID")
		for geneID, group in grouped_gtf:
		  #gene_length = max(list(group["stop"])) - min(list(group["start"]))
		  gene_length = group["stop"].max() - group["start"].min()
		  ### Count how many different exons there are in the reference isoform (the drop.duplicates should be superfluous)
		  exon_number = group.loc[group["feature"]=="exon",["chr", "feature", "start", "stop"]].drop_duplicates().shape[0]
		  group_df = pd.DataFrame({"GeneID" : [geneID], "Gene_length" : [gene_length], "Exon_number" : [exon_number]})
		  ### Join to final dataframe
		  final_df = pd.concat([final_df, group_df])
		### Filter for bilaterian conserved only
		bilaterian_conserved_genes = list(orthogroups_df["GeneID"])
		final_df = final_df.loc[final_df["GeneID"].isin(bilaterian_conserved_genes)]
		#Save to output
		final_df.to_csv(str(output), index=False, header=True, sep="\t", na_rep="NA")


rule associate_gene_length_and_exon_num:
	input:
		reg_genes = AS_VS_GE_REG_DIR+"/{species}/{category}/{species}-{reg_type}_regulated_genes.tab",
		gene_features = AS_VS_GE_REG_DIR+"/{species}/{species}-all_genes-gene_length_and_exon_num.tab"
	output:
		AS_VS_GE_REG_DIR+"/{species}/{category}/{species}-{reg_type}_regulated_genes-gene_length_and_exon_num.tab"
	run:
		import pandas as pd

		### Read inputs
		reg_genes_df = pd.read_table(str(input.reg_genes), sep="\t", header=None, index_col=False, names=["GeneID", "Tissue"])
		gene_features_df = pd.read_table(str(input.gene_features), sep="\t", index_col=False, header=0) #Header: GeneID, Gene_length, Exon_number
		### Combine dataframes and save to file
		final_df = reg_genes_df.merge(gene_features_df, on="GeneID", how="left")
		final_df.to_csv(str(output), sep="\t", header=False, index=False, na_rep="NA")


