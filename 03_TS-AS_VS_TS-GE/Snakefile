#This is a stupid event that has a duplicated gene ID. I am removing it, as it is not among my TS events.
#I am modifying this rule from how it was run in the thesis so that the new definition of "Associated tissue" is the one taken into account.
#Also, I am excluding the genes where there are DOWN exons (they are too difficult to interpret)
#I am also removing the "discarded" exons from the previous definition: they are selected by the get_tis_AS but do not pass the other cutoffs
rule get_AS_regulated_genes:
	input:
		TS_exons = TS_CALL+"/bilaterian_conserved/{species}/"+TS_CALL_PARAMS+"/TS_types/All_AS_types-associated_tissue_dPSI15-spec_pattern_PSI15-tau_0.6.tab", 
		event_gene_ID = DATABASE+"/event_gene_correspondences/{species}.Event-Gene.IDs.txt" 
	output:
		AS_reg_with_event = AS_VS_GE_REG_DIR+"/{species}/reference/{species}-AS_regulated_genes-with_event.tab",
		AS_reg_without_event = AS_VS_GE_REG_DIR+"/{species}/reference/{species}-AS_regulated_genes.tab"
	run:
		import pandas as pd

		### Upload input
		TS_exons_df = pd.read_table(str(input.TS_exons), sep="\t", header=0, index_col=False)
		event_geneID_df = pd.read_table(str(input.event_gene_ID), sep="\t", header=0, index_col=False)
		### Filter only for UP exons (necessary step)
		filtered_TS_exons_df = TS_exons_df.loc[TS_exons_df["Direction"]=="UP"][["EventID", "Direction", "Associated_Tis", "Exon_type"]].copy()
		### Remove discarded exons
		filtered_TS_exons_df = filtered_TS_exons_df.loc[filtered_TS_exons_df["Exon_type"]!="Discarded"]
		### Expand column with associated tissues
		filtered_TS_exons_df["Associated_Tis"] = filtered_TS_exons_df["Associated_Tis"].str.split(";")
		expanded_TS_exons_df = filtered_TS_exons_df.explode("Associated_Tis")
		### Add geneID
		event_geneID_dict = pd.Series(event_geneID_df.GeneID.values, index=event_geneID_df.EventID).to_dict()
		expanded_TS_exons_df["GeneID"] = expanded_TS_exons_df["EventID"].map(event_geneID_dict)
		### Reorder and save
		reordered_TS_exons_df = expanded_TS_exons_df[["GeneID", "EventID", "Associated_Tis", "Direction"]]
		reordered_TS_exons_df.to_csv(str(output.AS_reg_with_event), sep="\t", header=False, index=False, na_rep="NA")
		# Save output in the same format as TS-GE below
		filtered_TS_exons_df = reordered_TS_exons_df[["GeneID", "Associated_Tis"]].drop_duplicates()
		filtered_TS_exons_df.to_csv(str(output.AS_reg_without_event), sep="\t", header=False, index=False, na_rep="NA")


### Writing alternative rule that gives exactly the same result but maybe is a bit easier to read
rule get_GE_regulated_genes:
	input:
		"/users/mirimia/fmantica/projects/bilaterian_GE/data/ts_gains_losses/species_QN_5_TPM_v6/All_version2/Bilateria_conserved_orthogroups-All_genes-associated_tissues.tab"
	output:
		AS_VS_GE_REG_DIR+"/{species}/reference/{species}-GE_regulated_genes.tab"
	params:
		tau_cutoff = 0.75,
		expr_cutoff = "YES_EXPR" #This corresponds to an expr ≥ 5 TPMs in at least one tissue
	run:
		import pandas as pd

		### Upload input
		bilaterian_conserved_OG_df = pd.read_table(str(input), sep="\t", header=None, index_col=False, names=["OG_ID", "Species", "GeneID", "Tau", "Top_Tis", "Associated_Tis", "Expr_cutoff"])
		### Select TS genes and reduce df
		TS_genes_df = bilaterian_conserved_OG_df.loc[(bilaterian_conserved_OG_df["Species"]==str(wildcards.species)) & (bilaterian_conserved_OG_df["Tau"] >= params.tau_cutoff) & (bilaterian_conserved_OG_df["Expr_cutoff"]==params.expr_cutoff) & (bilaterian_conserved_OG_df["Top_Tis"]!="None")].copy()
		TS_genes_df = TS_genes_df[["GeneID", "Associated_Tis"]]
		### Explode tissue colum (tissues with double tissue-specificity will be divided)
		TS_genes_df["Associated_Tis"] = TS_genes_df["Associated_Tis"].str.split(";")
		expanded_TS_genes_df = TS_genes_df.explode("Associated_Tis")
		### Save to file
		expanded_TS_genes_df.to_csv(str(output), sep="\t", header=False, index=False, na_rep="NA")


