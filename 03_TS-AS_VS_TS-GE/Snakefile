#### This rule was gentle courtesy of Luisito
rule compute_all_intergenic_regions_by_species:
	input:
		#gtf = ALL_GTFS_DIR+"/{species}_annot-B-brochi.gtf"
		gtf = "/users/mirimia/fmantica/projects/bilaterian_GE/data/DB/corrected_gtf/All_version2/ref_gene_entries/{species}_annot-B-brochi.gtf"
	output:
		upstream = AS_VS_GE_REG_DIR+"/{species}/intergenic_regions_inputs/{species}_upstream_all_genes.txt",
		downstream =  AS_VS_GE_REG_DIR+"/{species}/intergenic_regions_inputs/{species}_downstream_all_genes.txt",
		combined = AS_VS_GE_REG_DIR+"/{species}/intergenic_regions_inputs/{species}_whole_intergenic_region.txt"
	shell:
		"""
		grep -P '\tgene\t' {input} | sort | uniq | sort -k1,1 -k4,4n > {wildcards.species}_sorted.gtf; \
		bedtools closest -id -D "ref" -t first -io -d -a {wildcards.species}_sorted.gtf -k 1 -b {wildcards.species}_sorted.gtf -mdb all | cut -f 1-9,19 > {output.upstream}.tmp; \
		bedtools closest -iu -D "ref" -t first -io -d -a {wildcards.species}_sorted.gtf -k 1 -b {wildcards.species}_sorted.gtf -mdb all | cut -f 1-9,19 > {output.downstream}.tmp; \
		cat {output.upstream}.tmp | awk 'BEGIN {{ FS = "\t" }};{{if($7=="+")print $0}}' > {output.upstream}; \
		cat {output.downstream}.tmp | awk 'BEGIN {{ FS = "\t" }};{{if($7=="-")print $0}}' >> {output.upstream}; \
		cat {output.downstream}.tmp | awk 'BEGIN {{ FS = "\t" }};{{if($7=="+")print $0}}' > {output.downstream}; \
		cat {output.upstream}.tmp | awk 'BEGIN {{ FS = "\t" }};{{if($7=="-")print $0}}' >> {output.downstream}; \
		cat {output.upstream} | awk '{{print $NF"\t"$10}}' | sed 's/"//g; s/;//' | awk '{{print $2"\t"$1}}' \
		| translate -a <(cat {output.downstream} | awk '{{print $NF"\t"$10}}' | sed 's/"//g; s/;//' | awk '{{print $2"\t"$1}}') 1 \
		| awk -v OFS="\t" 'function abs(v) {{v += 0; return v < 0 ? -v : v}} {{print $1,$2,$3,abs($2)+abs($3)}}' > {output.combined}
		rm {wildcards.species}_sorted.gtf {output.upstream}.tmp {output.downstream}.tmp;
		"""

rule associate_intergenic_regions_reg_genes:
	input:
		reg_genes = AS_VS_GE_REG_DIR+"/{species}/{category}/{species}-{reg_type}_regulated_genes.tab",
		intergenic_dist = AS_VS_GE_REG_DIR+"/{species}/intergenic_regions_inputs/{species}_whole_intergenic_region.txt" 
	output:
		AS_VS_GE_REG_DIR+"/{species}/{category}/{species}-{reg_type}_regulated_genes-intergenic_distances.tab"
	run:
		import pandas as pd

		### Read inputs
		reg_genes_df = pd.read_table(str(input.reg_genes), sep="\t", header=None, index_col=False, names=["GeneID", "Tissue"])
		intergenic_dist_df = pd.read_table(str(input.intergenic_dist), sep="\t", index_col=False, header=None, names=["GeneID", "Up_dist", "Down_dist", "Intergenic_dist"])[["GeneID", "Intergenic_dist"]]
		### Combine dataframes and save to file
		final_df = reg_genes_df.merge(intergenic_dist_df, on="GeneID", how="left")
		final_df.to_csv(str(output), sep="\t", header=False, index=False, na_rep="NA")


