### Compute the average disordered rate and the number of domains per gene
### Consider all protein isoforms
### I think I should normalize the number of domains in some way, as by default longer genes would tend to have more.
### In reality, I hope to see the opposite effect

#I am already filtering for bilaterian conserved genes
#Header: GENE, PROTEIN, START, STOP, ID, NAME, CLAN
#I will count the number of domains annotated in the reference protein, because I am not sure how to collapse the info across different isoforms
#IMPORTANT: this rule only works if the GeneIDs are unique between species (i.e., there are not more than 1 species with IDs from STRINGTIE or similar)

rule compute_domain_number:
	input:
		domain_file = DOM_DIS_DIR+"/{species}/{species}_prot_annot-pfam-parsed-sorted.tab.gz",
		reference_proteins = REF_PROT_DIR+"/{species}_gene_ref_prot_dict",
		broken_chimeric_file = BROKEN_CHIMERIC_DIR+"/{species}_new_geneIDs.txt",
		reg_file = AS_VS_GE_REG_DIR+"/{species}/{category}/{species}-{reg_type}_regulated_genes.tab"
	output:
		AS_VS_GE_REG_DIR+"/{species}/{category}/{species}-{reg_type}_regulated_genes-total_dom_num.tab"
	run:
		import pandas as pd

		### Upload inputs
		domain_df = pd.read_table(str(input.domain_file), sep="\t", index_col=False, header=0, names=["Original_GeneID", "ProteinID", "Start", "Stop", "ID", "Name", "Clan"]) #Header present
		reference_protein_df = pd.read_table(str(input.reference_proteins), sep="\t", index_col=False, header=None, names=["Original_GeneID", "ProteinID"])
		brochi_ids_df = pd.read_table(str(input.broken_chimeric_file), sep="\t", index_col=False, header=0, names=["Original_GeneID", "GeneID", "Category"])
		reg_df = pd.read_table(str(input.reg_file), sep="\t", index_col=False, header=None, names=["GeneID", "Tissue"])	
		### Filter for reference protein
		reference_protein_domain_df = domain_df.loc[domain_df["ProteinID"].isin(list(reference_protein_df["ProteinID"]))]
		### For broken and chimeric genes, replace original with new IDs
		### Small drawback for chimeric genes: the whole original gene will be considered (there is no straightforward way of separating them at this point)
		brochi_ids_df = brochi_ids_df[["Original_GeneID", "GeneID"]]
		brochi_ids_df["Original_GeneID"] = brochi_ids_df["Original_GeneID"].str.split(";")
		brochi_ids_df = brochi_ids_df.explode("Original_GeneID")
		brochi_ids_df["GeneID"] = brochi_ids_df["GeneID"].str.split(";")
		brochi_ids_df = brochi_ids_df.explode("GeneID")
		reference_protein_domain_df = reference_protein_domain_df.merge(brochi_ids_df, on="Original_GeneID", how="left")
		reference_protein_domain_df["GeneID"] = (reference_protein_domain_df["GeneID"].fillna(reference_protein_domain_df["Original_GeneID"])) 	
		### Compute total number of domains
		domain_counts_df = reference_protein_domain_df.groupby("GeneID").size().reset_index(name="Domain_num")
		### Add domain number info to regulated genes
		final_reg_df = reg_df.merge(domain_counts_df, on="GeneID", how="left")
		#final_reg_df["Domain_num"] = final_reg_df["Domain_num"].fillna(0).astype(int)
		### Save to output file
		final_reg_df.to_csv(str(output), sep="\t", header=False, index=False, na_rep="NA")


#No header in the disorder file: ENSP00000000233 1 M 0 0.0287
#Also, it has the protein ID only (no gene ID)
#Header of the suffix file: species geneID_prefix geneID_length transcript_suffix protein_suffix transcript_prefix protein_prefix
rule compute_average_disordered_rate:
	input:
		disorder_file = DOM_DIS_DIR+"/{species}/{species}-iupred_result.txt.gz",
		reference_proteins = REF_PROT_DIR+"/{species}_gene_ref_prot_dict",
		broken_chimeric_file = BROKEN_CHIMERIC_DIR+"/{species}_new_geneIDs.txt",
		reg_file = AS_VS_GE_REG_DIR+"/{species}/{category}/{species}-{reg_type}_regulated_genes.tab"
	output:
		AS_VS_GE_REG_DIR+"/{species}/{category}/{species}-{reg_type}_regulated_genes-average_dis_rate.tab"
	run:
		import pandas as pd

		### Upload inputs
		disordered_df = pd.read_table(str(input.disorder_file), sep="\t", index_col=False, header=None, names=["ProteinID", "AA_pos", "AA", "Dis_rate_bin", "Dis_rate_raw"])
		reference_protein_df = pd.read_table(str(input.reference_proteins), sep="\t", index_col=False, header=None, names=["Original_GeneID", "ProteinID"])
		brochi_ids_df = pd.read_table(str(input.broken_chimeric_file), sep="\t", index_col=False, header=0, names=["Original_GeneID", "GeneID", "Category"])
		reg_df = pd.read_table(str(input.reg_file), sep="\t", index_col=False, header=None, names=["GeneID", "Tissue"])
		### Filter for reference protein and add geneID
		reference_protein_disordered_df = disordered_df.loc[disordered_df["ProteinID"].isin(list(reference_protein_df["ProteinID"]))].copy()
		### Add geneID 
		reference_prot_geneID_dict = pd.Series(reference_protein_df.Original_GeneID.values, index=reference_protein_df.ProteinID)
		reference_protein_disordered_df["Original_GeneID"] = reference_protein_disordered_df["ProteinID"].map(reference_prot_geneID_dict)
		### For broken and chimeric genes replace the original with new IDs
		### Small drawback for chimeric genes: the whole original gene will be considered (there is no straightforward way of separating them at this point)
		brochi_ids_df = brochi_ids_df[["Original_GeneID", "GeneID"]]
		brochi_ids_df["Original_GeneID"] = brochi_ids_df["Original_GeneID"].str.split(";")
		brochi_ids_df = brochi_ids_df.explode("Original_GeneID")
		brochi_ids_df["GeneID"] = brochi_ids_df["GeneID"].str.split(";")
		brochi_ids_df = brochi_ids_df.explode("GeneID")
		reference_protein_disordered_df = reference_protein_disordered_df.merge(brochi_ids_df, on="Original_GeneID", how="left")
		reference_protein_disordered_df["GeneID"] = (reference_protein_disordered_df["GeneID"].fillna(reference_protein_disordered_df["Original_GeneID"])) 	
		### Compute average disorder by gene
		average_disordered_df = reference_protein_disordered_df.groupby("GeneID")["Dis_rate_raw"].mean().reset_index(name="Average_dis_rate")
		### Add average disordered info to regulated genes
		final_reg_df = reg_df.merge(average_disordered_df, on="GeneID", how="left")
		final_reg_df["Average_dis_rate"] = final_reg_df["Average_dis_rate"]
		### Save to output file
		final_reg_df.to_csv(str(output), sep="\t", header=False, index=False, na_rep="NA")



