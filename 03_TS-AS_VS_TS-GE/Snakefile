#### I think here I meant that the outgroup species are automatically excluded
### These rules compute both the average sequence similarity and the average expression similarity
rule compute_average_similarity_measure:
	input:
		reg_genes = AS_VS_GE_REG_DIR+"/{species}/{category}/{species}-{reg_type}_regulated_genes.tab",
		pairwise_seq_sim = VERTEBRATE_INSECT_DIR+"/pairwise_{similarity_measure}/all_pairwise_{similarity_measure}.txt"
	output:
		AS_VS_GE_REG_DIR+"/{species}/{category}/{species}-{reg_type}_regulated_genes-average_{similarity_measure}.tab"
	run:

		import pandas as pd
		import numpy as np
		
		### Read input files
		regulated_df = pd.read_table(str(input.reg_genes), sep="\t", index_col=False, header=None, names=["GeneID", "Tissue"])
		pairwise_seq_sim_df = pd.read_table(str(input.pairwise_seq_sim), sep="\t", index_col=False, header=None, names=["OG_ID", "Species1", "Species2", "GeneID1", "GeneID2", "Sim_mes"])
		### Get list of regulated genes
		reg_genes_list = list(set(list(regulated_df["GeneID"])))
		### Filter for regulated genes in GeneID1 (i.e., these genes are the query)
		filtered_pairwise_seq_sim_df = pairwise_seq_sim_df.loc[pairwise_seq_sim_df["GeneID1"].isin(reg_genes_list)]
		### Compute average by GeneID1 group
		average_sim_df = pd.DataFrame()
		grouped_seq_sim_df = filtered_pairwise_seq_sim_df.groupby("GeneID1")
		for GeneID, group in grouped_seq_sim_df:
		  GeneID_average_sim = np.nanmean(list(group["Sim_mes"]))
		  average_sim_df = pd.concat([average_sim_df, pd.DataFrame({"GeneID" : [GeneID], "Average_sim" : [GeneID_average_sim]})])
		if wildcards.species in ["Bla", "Sp2", "Sma", "Obi"]:
		  regulated_df["Average_sim"] = "NA"
		else:		
		  ### Get a dictionary in order to add the average seq sim value to the original dataframe
		  geneID_seq_sim_dict = pd.Series(average_sim_df.Average_sim.values, index=average_sim_df.GeneID).to_dict()
		  ### Add to original df
		  regulated_df["Average_sim"] = regulated_df["GeneID"].map(geneID_seq_sim_dict)
		### Save to file
		regulated_df.to_csv(str(output), sep="\t", index=False, header=False, na_rep="NA")


rule compute_average_similarity_measure_background:
	input:
		bilaterian_conserved = GENE_SETS_DIR+"/STRICT/Bilateria/conserved/Bilateria_conserved_orthogroups-EXPR_genes.txt",
		pairwise_seq_sim = VERTEBRATE_INSECT_DIR+"/pairwise_{similarity_measure}/all_pairwise_{similarity_measure}.txt"
	output:
		AS_VS_GE_REG_DIR+"/{species}/{species}-all_genes-average_{similarity_measure}.tab"
	run:

		import pandas as pd
		import numpy as np
		
		### Read inputs
		orthogroups_df = pd.read_table(str(input.bilaterian_conserved), sep="\t", index_col=False, header=None, names=["OG_ID", "Species", "GeneID"])
		orthogroups_df["Species"] = [species if species != "BmA" else "Bmo" for species in list(orthogroups_df["Species"])]
		pairwise_seq_sim_df = pd.read_table(str(input.pairwise_seq_sim), sep="\t", index_col=False, header=None, names=["OG_ID", "Species1", "Species2", "GeneID1", "GeneID2", "Sim_mes"])
		### Filter for genes of interest in GeneID1
		species_genes_list = list(orthogroups_df.loc[orthogroups_df["Species"]==str(wildcards.species)]["GeneID"])
		filtered_pairwise_seq_sim_df = pairwise_seq_sim_df.loc[pairwise_seq_sim_df["GeneID1"].isin(species_genes_list)]
		### Compute average by GeneID1 group
		average_sim_df = pd.DataFrame()
		grouped_seq_sim_df = filtered_pairwise_seq_sim_df.groupby("GeneID1")
		for GeneID, group in grouped_seq_sim_df:
		  GeneID_average_sim = np.nanmean(list(group["Sim_mes"]))
		  average_sim_df = pd.concat([average_sim_df, pd.DataFrame({"GeneID" : [GeneID], "Average_sim" : [GeneID_average_sim]})])
		### Get a dictionary in order to add the average seq sim value to the original dataframe
		if wildcards.species in ["Bla", "Sp2", "Sma", "Obi"]:
		  all_geneIDs = list(orthogroups_df.loc[orthogroups_df["Species"]==wildcards.species]["GeneID"])
		  geneID_seq_sim_df = pd.DataFrame({"GeneID" : all_geneIDs, "Average_sim" : ["NA" for element in all_geneIDs]})
		else:
		  geneID_seq_sim_dict = pd.Series(average_sim_df.Average_sim.values, index=average_sim_df.GeneID).to_dict()
		  ### Transform to dataframe and save to output
		  geneID_seq_sim_df = pd.DataFrame(list(geneID_seq_sim_dict.items()), columns=["GeneID", "Average_sim"])
		### Save to file
		geneID_seq_sim_df.to_csv(str(output), sep="\t", index=False, header=False, na_rep="NA")


