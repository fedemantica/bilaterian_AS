### I am going back to the original annotations used in the NatEcoEvo paper (Ensembl v106 and ClueGO) to derive the domain annotation (CC, BP, MF)
### Careful if changing the input names in this rule (direct reference in the body)
rule derive_domain_annotations:
	input:
		ensembl_annot = "/users/mirimia/fmantica/projects/vertebrate_insect_GE/data/GO_annotations/full_annot/Hs2-GO_annot-Ensembl_v106.txt",
		ClueGO_annot = expand(CLUE_GO_DIR+"/hg38_{domain_type}_out-leveled.tab", domain_type = ["BiologicalProcess", "CellularComponent", "MolecularFunction"])
	output:
		DATABASE+"/GO_annot/GO_terms-names-domains_correspondences.tab"
	params:
		domain_types_dict = {"BiologicalProcess" : "biological_process", "CellularComponent" : "cellular_component", "MolecularFunction" : "molecular_function"}
	run:
		import pandas as pd
		import os

		### Read in Ensembl inputs
		ensembl_annot_df = pd.read_table(input.ensembl_annot, sep="\t", header=0, index_col=False, names=["GeneID", "GO_domain", "GO_term", "GO_Name", "GO_evidence"])
		ensembl_annot_df = ensembl_annot_df[["GO_term", "GO_Name", "GO_domain"]].drop_duplicates()
		### Initialize final_df
		final_df = pd.DataFrame()
		### Read in ClueGO inputs
		for cluego_file in input.ClueGO_annot:
		  basename = os.path.basename(cluego_file)
		  domain_type = basename.split("_")[1] 
		  cluego_df = pd.read_table(cluego_file, sep="\t", index_col=False, header=None, names=["GeneID", "GO_term", "GO_Name", "Level"])
		  cluego_df["GO_domain"] = params.domain_types_dict[domain_type]
		  cluego_df = cluego_df[["GO_term", "GO_Name", "GO_domain"]].drop_duplicates() 
		  final_df = pd.concat([final_df, cluego_df])
		### Only consider GO terms that are not alread in the Ensembl annotation
		final_df = final_df.loc[~final_df["GO_term"].isin(ensembl_annot_df["GO_term"])].copy()
		### Add Ensembl annotation and modofy GO_Name
		final_df = pd.concat([final_df, ensembl_annot_df])
		final_df["GO_Name"] = final_df["GO_Name"].str.replace(";", "_", regex=False).str.replace(" ", "_", regex=False)
		### Save to file
		final_df.to_csv(str(output), sep="\t", header=False, index=False, na_rep="NA")
